# Local development defaults. Blank DATABASE_URL uses a local SQLite database.
APP_ENV=development
DATABASE_URL=
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Voice remains disabled for the demo. Credentials are not required.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_WEB_CALL_ENABLED=false
BOLNA_WEBHOOK_SECRET=

# Reserved for integrations not implemented yet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
EMAIL_PROVIDER_API_KEY=
