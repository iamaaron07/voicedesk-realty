# Local development defaults. Production must set APP_ENV=production and a managed PostgreSQL DATABASE_URL.
APP_ENV=development
DATABASE_URL=
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Voice requires backend-only credentials; set false to temporarily disable it.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_WEB_CALL_ENABLED=true
BOLNA_WEBHOOK_SECRET=

# Reserved for integrations that are not implemented in this project yet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
EMAIL_PROVIDER_API_KEY=
